# Application
APP_ENV=development
SECRET_KEY=replace_with_a_secure_random_secret
CORS_ORIGINS=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database
POSTGRES_DB=animal_monitoring
POSTGRES_USER=habitat
POSTGRES_PASSWORD=replace_with_local_database_password
DATABASE_URL=postgresql://habitat:replace_with_local_database_password@postgres:5432/animal_monitoring

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace_with_local_access_key
MINIO_SECRET_KEY=replace_with_local_secret_key
MINIO_BUCKET=animal-media

# AI model
MODEL_PATH=/models/best.pt

# LLM (optional)
OLLAMA_BASE_URL=http://host.docker.internal:11434
